{
  "expo": {
    "name": "SavLife",
    "slug": "savlife",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0E9F6E"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.savlife.emergency",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "SavLife needs your location to dispatch ambulances to your exact position."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0E9F6E"
      },
      "package": "com.savlife.emergency",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "googleMapsApiKey": "GOOGLE_MAPS_API_KEY",
      "nvidiaNimApiKey": "NVIDIA_NIM_API_KEY"
    }
  }
}
